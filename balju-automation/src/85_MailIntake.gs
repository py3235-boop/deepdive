/**
 * 85_MailIntake.gs — Gmail 에서 발주서를 거둬 고객사별로 분리 저장하고 기록한다.
 *
 * 두 경로를 모두 처리한다:
 *   본문 HTML 표   — **고객사 A 의 주 경로.** 첨부 없이 본문에 표로 온다
 *   첨부파일       — 형식별로 추출. 식별된 고객사 폴더로 자동 분리 저장
 *
 * 처리한 메일은 **읽음 처리**한다. 다만 중복 방지는 읽음 여부로 판단하지 않는다 —
 * 사람이 메일을 먼저 열어볼 수 있으므로, `처리로그` 의 식별키로 판단한다.
 *
 * ── 식별 순서 ──
 * 저장할 폴더를 정하려면 고객사를 먼저 알아야 하는데 `문서내용` 규칙은 파일을 열어야 평가된다.
 *   1) 메일 단위 정보(발신자·제목·본문·첨부파일명)로 먼저 채점
 *   2) 미확정이면 첨부를 추출해 `문서내용` 까지 넣고 다시 채점
 *   3) 그래도 미확정이면 미분류 폴더에 저장 → 사람이 해당 고객사 폴더로 옮긴다
 *
 * 첨부는 **파일 단위로 판정**한다. 한 메일에 A 와 C 발주서가 같이 와도 각각 다른 폴더로 간다.
 */

/** 한 번 실행에 훑을 스레드 수 상한 (Apps Script 실행 시간 6분 제한 때문) */
const _기본최대스레드 = 20;

/**
 * Gmail 검색식. `설정` 탭의 `메일.검색식` 이 있으면 그것을 쓰고,
 * 없으면 고객사식별 탭의 제목·본문 키워드로 만든다.
 *
 * 기본 검색식: `in:inbox is:unread (고객사명…) newer_than:N일`
 *
 * ⚠️ `in:inbox` 가 반드시 들어간다. `GmailApp.search()` 는 그냥 두면
 * **보낸편지함·임시보관함까지 훑는다.** 발주서는 받은편지함으로 오는 것만 처리한다
 * (실측: 본인이 보낸 테스트 메일이 검색에 걸려 그대로 기록됐다).
 *
 * `is:unread` 는 읽음처리와 짝을 이뤄 대기열이 된다 — **안읽음=처리 대기, 읽음=처리 완료.**
 * 대신 담당자가 메일을 먼저 열어보면 그 건은 자동 수집에서 빠진다. 그때는 Gmail 에서
 * 다시 안읽음으로 표시하면 다음 실행에 잡힌다 (식별키가 중복을 막는다).
 *
 * 설정 탭에서 바꾸면 코드 수정 없이 전략을 갈아탈 수 있다.
 *   예) `in:inbox label:발주서`   — 읽음 여부와 무관하게 라벨 붙은 것만
 *       `in:inbox newer_than:7d`  — 최근 일주일 받은편지함 전체
 * 직접 지정할 때도 `in:inbox` 를 잊지 말 것.
 */
function 메일_검색식() {
  const 설정된 = 설정전체()['메일.검색식'];
  if (설정된) return 설정된;

  const 키워드들 = {};
  식별규칙_로드().규칙들.forEach(function (r) {
    if (r.대상 === '메일제목' || r.대상 === '메일본문' || r.대상 === '파일명') {
      키워드들[r.키워드] = true;
    }
  });

  const 목록 = Object.keys(키워드들);
  if (!목록.length) return 'in:inbox is:unread has:attachment';

  // 기간을 자른다. 안 자르면 매 실행마다 몇 달치를 다시 훑는다.
  const 일수 = 숫자파싱(설정전체()['메일.최근일수']) || 60;

  return 'in:inbox is:unread (' +
    목록.map(function (k) { return '"' + k + '"'; }).join(' OR ') + ')' +
    ' newer_than:' + 일수 + 'd';
}

/**
 * Gmail 메일 하나로 바로 가는 주소.
 *
 * `#all/` 을 쓴다 — `#inbox/` 는 메일을 보관처리하면 열리지 않는다.
 * `/u/0/` 은 브라우저에 로그인된 **첫 번째 계정**을 뜻한다. 회사 계정이 첫 번째가 아니면
 * 다른 계정으로 열리므로, 그런 경우 `설정` 탭의 `메일.계정번호` 를 바꾼다.
 */
function _메일URL(메시지) {
  const 번호 = 설정전체()['메일.계정번호'] || '0';
  return 'https://mail.google.com/mail/u/' + 번호 + '/#all/' + 메시지.getId();
}

/** 처리 완료 표시용 Gmail 라벨 이름 */
function _처리완료라벨명() {
  return 설정전체()['메일.라벨'] || '발주서처리완료';
}

/**
 * 처리 완료 라벨을 얻는다. 없으면 만든다.
 *
 * ⚠️ 이 라벨을 **검색 제외 조건으로 쓰지 않는다.** Gmail 라벨은 메일 단위가 아니라
 * 스레드 단위라서, 같은 스레드에 답장으로 새 발주서가 오면 라벨 때문에 검색에서 빠진다.
 * 라벨은 사람이 한눈에 구분하기 위한 표시일 뿐이고, 실제 중복 판단은 메일별 식별키로 한다.
 */
function _처리완료라벨() {
  const 이름 = _처리완료라벨명();
  try {
    return GmailApp.getUserLabelByName(이름) || GmailApp.createLabel(이름);
  } catch (e) {
    Logger.log('라벨 확보 실패(무시): ' + e);
    return null;
  }
}

/**
 * 메일 수집 본체. 시간 기반 트리거가 이 함수를 부른다.
 *
 * @param {Object} 옵션 { 검색식, 최대스레드, 읽음처리 }
 * @return {Object} 수집 요약
 */
function 메일수집(옵션) {
  옵션 = 옵션 || {};
  const 검색식 = 옵션.검색식 || 메일_검색식();
  const 최대 = 옵션.최대스레드 || 숫자파싱(설정전체()['메일.최대스레드']) || _기본최대스레드;
  const 읽음처리할까 = 옵션.읽음처리 === undefined ? true : !!옵션.읽음처리;

  const 규칙 = 변환규칙_로드();
  const 양식 = 양식_로드();

  const 요약 = {
    검색식: 검색식,
    스레드수: 0, 메일수: 0,
    본문처리: 0, 첨부처리: 0, 미분류: 0, 건너뜀: 0,
    기록행수: 0, 미매핑수: 0,
    상세: [],
  };

  const 라벨 = _처리완료라벨();
  const 스레드들 = GmailApp.search(검색식, 0, 최대);
  요약.스레드수 = 스레드들.length;

  스레드들.forEach(function (스레드) {
    let 이스레드에서처리 = 0;

    스레드.getMessages().forEach(function (메시지) {
      요약.메일수++;
      const 한건 = _메일하나처리(메시지, 규칙, 양식, 요약);
      요약.상세.push(한건);
      if (읽음처리할까 && 한건.처리한것 > 0) 메시지.markRead();
      이스레드에서처리 += 한건.처리한것;
    });

    // 라벨은 스레드 단위다. 실제로 뭔가 처리한 스레드에만 붙인다 (표시용)
    if (라벨 && 이스레드에서처리 > 0) {
      try { 스레드.addLabel(라벨); } catch (e) { Logger.log('라벨 부착 실패(무시): ' + e); }
    }
  });

  return 요약;
}

/** 메일 한 통 처리 */
function _메일하나처리(메시지, 규칙, 양식, 요약) {
  const 메시지ID = 메시지.getId();
  const 제목 = 메시지.getSubject() || '';
  const 발신자 = 메시지.getFrom() || '';
  const 본문텍스트 = 메시지.getPlainBody() || '';

  const 결과 = { 메시지ID: 메시지ID, 제목: 제목, 발신자: 발신자, 처리한것: 0, 항목들: [] };

  // 메일 단위 문맥 — 1단계 채점에 쓴다
  const 메일문맥 = { 발신자: 발신자, 메일제목: 제목, 메일본문: 본문텍스트 };
  const 메일판정 = 고객사식별(메일문맥);

  // ── 첨부파일 ──
  메시지.getAttachments({ includeInlineImages: false, includeAttachments: true })
    .forEach(function (첨부) {
      const 항목 = _첨부하나처리(첨부, 메시지ID, 메일문맥, 메일판정, 규칙, 양식, 요약);
      결과.항목들.push(항목);
      if (항목.처리) 결과.처리한것++;
    });

  // ── 본문 표 (고객사 A 의 주 경로) ──
  const 본문항목 = _본문처리(메시지, 메시지ID, 메일판정, 규칙, 양식, 요약);
  if (본문항목) {
    결과.항목들.push(본문항목);
    if (본문항목.처리) 결과.처리한것++;
  }

  return 결과;
}

/** 첨부 하나: 식별 → 폴더 저장 → 처리 → 기록 */
function _첨부하나처리(첨부, 메시지ID, 메일문맥, 메일판정, 규칙, 양식, 요약) {
  const 이름 = 첨부.getName();
  const 식별키 = 메시지ID + '#' + 이름;
  const 항목 = { 종류: '첨부', 이름: 이름, 처리: false, 메모: '' };

  // 이미 처리한 첨부면 파일을 다시 저장하지도 않는다
  if (이미처리했나(식별키)) {
    항목.메모 = '이미 처리함 — 건너뜀';
    요약.건너뜀++;
    return 항목;
  }

  const blob = 첨부.copyBlob();
  const 추출결과 = 추출({ blob: blob, 파일명: 이름 });

  // 2단계 채점 — 첨부파일명과 문서내용까지 넣어 다시 본다
  const 판정 = 고객사식별({
    발신자: 메일문맥.발신자,
    메일제목: 메일문맥.메일제목,
    메일본문: 메일문맥.메일본문,
    파일명: 이름,
    문서내용: 추출결과.원문,
  });
  const 고객사 = 판정.고객사 || 메일판정.고객사 || null;

  // 폴더 저장 — 미판별이면 미분류 폴더로
  const 폴더 = 고객사폴더(고객사);
  const 저장된 = 폴더.createFile(blob.setName(이름));
  항목.저장위치 = 폴더.getName();
  항목.저장ID = 저장된.getId();

  if (!고객사) {
    요약.미분류++;
    항목.메모 = '고객사 미판별 → 미분류 폴더에 보관. ' + 판정.근거;
    미매핑_기록(new Date(), '메일', 이름, '(미분류)', 항목.메모, '');
    처리로그_기록(new Date(), '메일', 이름, '(미분류)', 판정.근거, '미분류 보관', '', 식별키);
    return 항목;
  }

  if (!추출결과.성공) {
    항목.메모 = '추출 실패: ' + (추출결과.메타.실패사유 || '?');
    미매핑_기록(new Date(), '메일', 이름, 고객사, 항목.메모, '');
    처리로그_기록(new Date(), '메일', 이름, 고객사, 판정.근거, '추출 실패', 항목.메모, 식별키);
    return 항목;
  }

  // 출처는 메일이 아니라 **고객사 폴더에 저장된 그 파일**로 연결한다.
  // 첨부는 어차피 자동 분리 저장되므로 파일로 바로 가는 게 유용하다.
  const R = 처리(고객사, 추출결과, 규칙, 양식);
  const 기록요약 = 기록(R, {
    채널: '메일(첨부)', 원본이름: 이름, 식별키: 식별키,
    출처URL: 저장된.getUrl(),
  });

  항목.처리 = !기록요약.보류;
  항목.메모 = 기록요약.보류
    ? '보류: ' + 기록요약.메모.join(' / ')
    : '기록 ' + 기록요약.기록수 + '행';
  항목.고객사 = 고객사;

  // 저장한 파일에도 완료 표시를 한다.
  // 안 하면 나중에 드라이브 스캔이 같은 파일을 다시 처리한다 (식별키가 서로 다르므로).
  if (항목.처리) {
    const 새이름 = 완료표시(저장된);
    if (새이름) 항목.저장이름 = 새이름;
  }

  요약.첨부처리++;
  요약.기록행수 += 기록요약.기록수;
  요약.미매핑수 += 기록요약.미매핑수;
  return 항목;
}

/**
 * 메일 본문의 표 처리. 고객사 A 는 첨부 없이 본문 표로 온다.
 *
 * 본문에는 서명·인용답장 같은 레이아웃 표도 섞인다. 40_Parse.gs 의 _표찾기 가
 * **헤더 내용으로** 진짜 발주 표를 골라내므로 여기서는 걸러내지 않는다.
 * 파싱 결과 행이 0개면 발주 표가 아니었다고 보고 조용히 넘어간다.
 */
function _본문처리(메시지, 메시지ID, 메일판정, 규칙, 양식, 요약) {
  const 식별키 = 메시지ID + '#본문';
  const 제목 = 메시지.getSubject() || '(제목없음)';
  const 항목 = { 종류: '본문', 이름: 제목, 처리: false, 메모: '' };

  if (이미처리했나(식별키)) {
    항목.메모 = '이미 처리함 — 건너뜀';
    요약.건너뜀++;
    return 항목;
  }

  const 추출결과 = 추출({ html: 메시지.getBody(), 파일명: 제목 });
  if (!추출결과.표들.length) return null; // 본문에 표가 아예 없으면 조용히 넘어간다

  const 고객사 = 메일판정.고객사;
  if (!고객사) {
    // 본문 표는 폴더에 저장할 파일이 없다. 기록만 남기고 사람이 처리하게 한다.
    요약.미분류++;
    항목.메모 = '본문에 표가 있으나 고객사를 판별하지 못했습니다. ' + 메일판정.근거;
    미매핑_기록(new Date(), '메일(본문)', 제목, '(미분류)', 항목.메모,
      JSON.stringify(추출결과.표들[0] || []).slice(0, 500));
    처리로그_기록(new Date(), '메일(본문)', 제목, '(미분류)', 메일판정.근거,
      '미분류', '표 ' + 추출결과.표들.length + '개', 식별키);
    return 항목;
  }

  const R = 처리(고객사, 추출결과, 규칙, 양식);
  if (!R.파서결과.행들.length) {
    // 발주 표가 아니었다 (서명·인용 표만 있었다). 로그를 남기지 않는다.
    return null;
  }

  const 기록요약 = 기록(R, {
    채널: '메일(본문)', 원본이름: 제목, 식별키: 식별키,
    출처URL: _메일URL(메시지),
  });

  항목.처리 = !기록요약.보류;
  항목.고객사 = 고객사;
  항목.메모 = 기록요약.보류
    ? '보류: ' + 기록요약.메모.join(' / ')
    : '기록 ' + 기록요약.기록수 + '행';

  요약.본문처리++;
  요약.기록행수 += 기록요약.기록수;
  요약.미매핑수 += 기록요약.미매핑수;
  return 항목;
}

// ─────────────────────────────────────────────────────────────
// 트리거
// ─────────────────────────────────────────────────────────────

const _트리거함수 = '메일수집';

/** 주기 실행 트리거를 설치한다. 기존 것은 지우고 하나만 남긴다. */
function 트리거_설치(분) {
  트리거_제거();
  const 간격 = 분 || 숫자파싱(설정전체()['메일.트리거분']) || 15;
  ScriptApp.newTrigger(_트리거함수).timeBased().everyMinutes(_허용간격(간격)).create();
  설정값쓰기('메일.트리거분', String(_허용간격(간격)), '메일 수집 주기(분)');
  return '트리거 설치: ' + _허용간격(간격) + '분마다 ' + _트리거함수 + '()';
}

/** everyMinutes 는 1·5·10·15·30 만 받는다. 가까운 값으로 맞춘다. */
function _허용간격(분) {
  const 허용 = [1, 5, 10, 15, 30];
  let 최선 = 허용[0];
  허용.forEach(function (v) {
    if (Math.abs(v - 분) < Math.abs(최선 - 분)) 최선 = v;
  });
  return 최선;
}

/** 이 스크립트의 메일수집 트리거를 모두 지운다. */
function 트리거_제거() {
  let 지운수 = 0;
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === _트리거함수) {
      ScriptApp.deleteTrigger(t);
      지운수++;
    }
  });
  return '트리거 ' + 지운수 + '개 제거';
}

/** 현재 트리거 상태 */
function 트리거_상태() {
  const 목록 = ScriptApp.getProjectTriggers().filter(function (t) {
    return t.getHandlerFunction() === _트리거함수;
  });
  return 목록.length
    ? '트리거 ' + 목록.length + '개 동작 중 (' + _트리거함수 + ')'
    : '트리거 없음';
}

// ─────────────────────────────────────────────────────────────
// 검증
// ─────────────────────────────────────────────────────────────

/**
 * Phase 5 검증용. 실제로 메일을 읽고 저장·기록한다.
 * 먼저 검색식이 무엇을 잡는지 확인하고, 그 다음 처리 결과를 찍는다.
 */
function 메일수집_테스트() {
  const 줄 = [];
  function p(s) { 줄.push(s); Logger.log(s); }

  const 검색식 = 메일_검색식();
  p('검색식: ' + 검색식);
  p('처리완료 라벨: ' + _처리완료라벨명() + ' (표시용 — 검색 제외에는 쓰지 않음)');
  p('중복 판단: 처리로그의 식별키 (메시지ID#첨부이름 / 메시지ID#본문)');
  p('트리거: ' + 트리거_상태());

  const 미리보기 = GmailApp.search(검색식, 0, 10);
  p('');
  p('===== 검색에 걸린 스레드 ' + 미리보기.length + '개 =====');
  미리보기.forEach(function (t) {
    const m = t.getMessages()[0];
    p('   [' + (t.isUnread() ? '안읽음' : '읽음') + '] ' + m.getFrom() +
      ' / ' + m.getSubject() +
      ' / 첨부 ' + m.getAttachments().length + '개');
  });

  if (!미리보기.length) {
    p('');
    p('걸린 메일이 없습니다. 고객사명이 제목·본문에 들어간 메일을 자기 계정으로 보내보세요.');
    return 줄.join('\n');
  }

  p('');
  p('===== 수집 실행 =====');
  const 요약 = 메일수집({ 최대스레드: 10 });
  p('스레드 ' + 요약.스레드수 + ' / 메일 ' + 요약.메일수 +
    ' / 본문처리 ' + 요약.본문처리 + ' / 첨부처리 ' + 요약.첨부처리 +
    ' / 미분류 ' + 요약.미분류 + ' / 건너뜀 ' + 요약.건너뜀);
  p('기록 ' + 요약.기록행수 + '행 / 미매핑 ' + 요약.미매핑수 + '건');

  요약.상세.forEach(function (건) {
    if (!건.항목들.length) return;
    p('');
    p('── ' + 건.발신자 + ' / ' + 건.제목);
    건.항목들.forEach(function (항목) {
      p('   [' + 항목.종류 + '] ' + 항목.이름 +
        (항목.고객사 ? ' → ' + 항목.고객사 : '') +
        (항목.저장위치 ? ' (저장: ' + 항목.저장위치 + ')' : '') +
        ' — ' + (항목.메모 || ''));
    });
  });

  return 줄.join('\n');
}

/** 시트 메뉴용 래퍼들 */
function 메일수집_테스트_메뉴() {
  const 결과 = 메일수집_테스트();
  const ui = SpreadsheetApp.getUi();
  ui.alert('메일 수집 테스트', 결과.slice(0, 4000), ui.ButtonSet.OK);
}

function 트리거_설치_메뉴() {
  const ui = SpreadsheetApp.getUi();
  ui.alert('트리거', 트리거_설치(), ui.ButtonSet.OK);
}

function 트리거_제거_메뉴() {
  const ui = SpreadsheetApp.getUi();
  ui.alert('트리거', 트리거_제거(), ui.ButtonSet.OK);
}
