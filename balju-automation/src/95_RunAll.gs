/**
 * 95_RunAll.gs — 맞춤 메뉴에서 전 과정을 한 번에 돌린다.
 *
 * 순서: 규칙 로드 → 식별 규칙 → 드라이브 수집 → 메일 수집
 *
 * 팝업에는 짧은 요약만 띄우고 상세 내용은 실행 로그에 남긴다
 * (ui.alert 는 긴 글을 담지 못한다).
 */

/**
 * 전 과정 실행.
 * @return {{요약:string, 상세:string, 문제:number}}
 */
function 전체_실행() {
  const 요약줄 = [];
  const 상세줄 = [];
  let 문제 = 0;

  function 요(s) { 요약줄.push(s); }
  function 상(s) { 상세줄.push(s); }

  const 시작 = new Date();

  // ── 1. 참조 시트 ──
  상('##########  1. 참조 시트 로드  ##########');
  let 규칙, 양식;
  try {
    규칙 = 변환규칙_로드();
    양식 = 양식_로드();

    const 건수 = 고객사목록.map(function (c) {
      return c.replace('고객사', '') + ' ' + Object.keys(규칙[c] || {}).length;
    }).join(' / ');
    요('1. 변환규칙  ' + 건수 + '건, 단위중량 ' + JSON.stringify(규칙.단위중량));

    const 레이아웃요약 = 고객사목록.map(function (c) {
      const L = 양식.레이아웃[c];
      return c.replace('고객사', '') + ' ' + (L ? L.전체폭 + '열' : '없음');
    }).join(' / ');
    요('   양식 레이아웃  ' + 레이아웃요약);

    상(규칙_로드_테스트());

    const 경고 = 규칙.경고.concat(양식.경고);
    if (경고.length) {
      문제 += 경고.length;
      요('   ! 경고 ' + 경고.length + '건 — ' + 경고[0] + (경고.length > 1 ? ' …' : ''));
    }
  } catch (e) {
    문제++;
    요('1. 참조 시트 로드 실패 — ' + e);
    상('실패: ' + e);
    return _전체결과(요약줄, 상세줄, 문제, 시작);
  }

  // ── 2. 식별 규칙 ──
  상('');
  상('##########  2. 식별 규칙  ##########');
  try {
    _식별규칙캐시 = null;
    const 로드 = 식별규칙_로드();
    요('2. 식별 규칙  ' + 로드.규칙들.length + '개');
    if (로드.경고.length) {
      문제 += 로드.경고.length;
      요('   ! ' + 로드.경고[0]);
    }
    로드.규칙들.forEach(function (r) {
      상('   ' + r.고객사 + ' / ' + r.대상 + ' / "' + r.키워드 + '" / +' + r.가중치);
    });
  } catch (e) {
    문제++;
    요('2. 식별 규칙 실패 — ' + e);
    상('실패: ' + e);
  }

  // ── 3. 드라이브 수집 ──
  상('');
  상('##########  3. 드라이브 수집  ##########');
  try {
    const D = 드라이브수집();
    요('3. 드라이브  처리 ' + D.처리파일 + '파일 / 건너뜀 ' + D.건너뜀 +
      (D.실패 ? ' / 실패 ' + D.실패 : '') + ' → 기록 ' + D.기록행수 + '행' +
      (D.대체수 ? ' / 대체 ' + D.대체수 : '') +
      (D.미매핑수 ? ' / 미매핑 ' + D.미매핑수 : ''));
    if (D.실패) 문제 += D.실패;
    if (D.미매핑수) 문제 += D.미매핑수;
    상(드라이브수집_설명(D));
  } catch (e) {
    문제++;
    요('3. 드라이브 수집 실패 — ' + e);
    상('실패: ' + e);
  }

  // ── 4. 메일 수집 ──
  상('');
  상('##########  4. 메일 수집  ##########');
  try {
    const 검색식 = 메일_검색식();
    상('검색식: ' + 검색식);

    const M = 메일수집({ 최대스레드: 10 });
    요('4. 메일  스레드 ' + M.스레드수 + ' → 본문 ' + M.본문처리 +
      ' / 첨부 ' + M.첨부처리 + ' / 미분류 ' + M.미분류 + ' / 건너뜀 ' + M.건너뜀 +
      ' → 기록 ' + M.기록행수 + '행' + (M.미매핑수 ? ' / 미매핑 ' + M.미매핑수 : ''));
    if (M.미분류) 문제 += M.미분류;
    if (M.미매핑수) 문제 += M.미매핑수;

    상('스레드 ' + M.스레드수 + ' / 메일 ' + M.메일수);
    M.상세.forEach(function (건) {
      if (!건.항목들.length) return;
      상('');
      상('── ' + 건.발신자 + ' / ' + 건.제목);
      건.항목들.forEach(function (항목) {
        상('   [' + 항목.종류 + '] ' + 항목.이름 +
          (항목.고객사 ? ' → ' + 항목.고객사 : '') +
          (항목.저장위치 ? ' (저장: ' + 항목.저장위치 + ')' : '') +
          ' — ' + (항목.메모 || ''));
      });
    });
  } catch (e) {
    문제++;
    요('4. 메일 수집 실패 — ' + e);
    상('실패: ' + e);
  }

  // ── 5. 산출물 위치 ──
  const 파일들 = [];
  const 설정 = 설정전체();
  Object.keys(설정).sort().forEach(function (키) {
    if (키.indexOf('출력파일.') !== 0) return;
    파일들.push(키.replace('출력파일.', '') + ' 발주서: ' +
      'https://docs.google.com/spreadsheets/d/' + 설정[키] + '/edit');
  });
  if (파일들.length) {
    요('');
    요('산출물:');
    파일들.forEach(function (f) { 요('  ' + f); });
    상('');
    상('##########  산출물  ##########');
    파일들.forEach(function (f) { 상('   ' + f); });
  }

  // 로그가 쌓이면 열 폭이 다시 좁아 보인다. 실행 끝에 서식을 다시 맞춘다
  try {
    관리시트_서식();
  } catch (e) {
    상('관리 시트 서식 실패(무시): ' + e);
  }

  return _전체결과(요약줄, 상세줄, 문제, 시작);
}

function _전체결과(요약줄, 상세줄, 문제, 시작) {
  const 초 = Math.round((new Date() - 시작) / 100) / 10;
  const 머리 = 문제 === 0
    ? '전부 통과 (' + 초 + '초)'
    : '확인 필요 ' + 문제 + '건 (' + 초 + '초)';

  const 요약 = [머리, ''].concat(요약줄).join('\n');
  const 상세 = 상세줄.join('\n');

  Logger.log(요약);
  Logger.log('');
  Logger.log('================ 상세 ================');
  Logger.log(상세);

  return { 요약: 요약, 상세: 상세, 문제: 문제 };
}

/** 시트 메뉴용. 짧은 요약을 띄우고 상세는 실행 로그로 보낸다. */
function 전체_실행_메뉴() {
  const R = 전체_실행();
  const ui = SpreadsheetApp.getUi();
  ui.alert('전체 실행 결과',
    R.요약 + '\n\n(상세 내용은 Apps Script 실행 로그에 있습니다)',
    ui.ButtonSet.OK);
}

/**
 * 초기화한 뒤 전 과정을 다시 돌린다. 시연 리허설용.
 * 되돌릴 수 없으니 한 번 묻는다.
 */
function 전체_재실행_메뉴() {
  const ui = SpreadsheetApp.getUi();
  const 답 = ui.alert(
    '초기화 후 전체 재실행',
    '월별 발주서 파일을 휴지통으로 보내고 처리로그를 비운 뒤, 전 과정을 다시 돌립니다.\n\n'
    + '주의: 드라이브 파일의 `_완료` 꼬리표와 메일 읽음 상태는 되돌리지 않습니다.\n'
    + '완전히 처음부터 하려면 파일명에서 `_완료` 를 떼고 메일을 안읽음으로 바꿔주세요.\n\n'
    + '계속할까요?',
    ui.ButtonSet.YES_NO
  );
  if (답 !== ui.Button.YES) return;

  const 초기화결과 = 산출물_초기화();
  const R = 전체_실행();
  ui.alert('초기화 후 전체 재실행 결과',
    '[초기화]\n' + 초기화결과 + '\n\n[전체 실행]\n' + R.요약,
    ui.ButtonSet.OK);
}
