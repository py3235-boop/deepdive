/**
 * 20_규칙.gs — 참조 시트 두 개를 읽어 메모리 구조로 만든다.
 *
 *  변환규칙 시트 : 고객사 원본 값 → 딥다이브 품목/품목코드/규격
 *  양식 시트     : 월별 파일의 고객사 탭 레이아웃 (왼쪽=원본, 빈 열, 오른쪽=변환결과)
 *
 * 두 시트 모두 한 탭에 표가 여러 개 쌓여 있고 위치가 언제든 바뀔 수 있으므로,
 * 좌표를 박지 않고 헤더 내용을 보고 표를 찾는다.
 */

// ─────────────────────────────────────────────────────────────
// 공통 유틸
// ─────────────────────────────────────────────────────────────

/** 스프레드시트의 모든 탭에서 값 격자를 모아 돌려준다. */
function _격자모음(시트ID) {
  return SpreadsheetApp.openById(시트ID).getSheets().map(function (s) {
    return { 탭: s.getName(), 격자: s.getDataRange().getValues() };
  });
}

/** 배열 뒤쪽의 빈 칸을 잘라낸다. */
function _뒤빈칸제거(arr) {
  const out = arr.map(function (v) { return String(v == null ? '' : v).trim(); });
  while (out.length && out[out.length - 1] === '') out.pop();
  return out;
}

/** 행에 주어진 헤더 이름들이 모두 있는지 */
function _헤더포함(행, 이름들) {
  const set = 행.map(키정규화);
  return 이름들.every(function (n) { return set.indexOf(키정규화(n)) >= 0; });
}

/** 행에서 헤더 이름의 열 인덱스를 찾는다. 없으면 -1 */
function _열찾기(행, 이름) {
  const target = 키정규화(이름);
  for (let i = 0; i < 행.length; i++) if (키정규화(행[i]) === target) return i;
  return -1;
}

// ─────────────────────────────────────────────────────────────
// 변환규칙 시트
// ─────────────────────────────────────────────────────────────

/**
 * 변환규칙을 읽어 고객사별 매핑 테이블을 만든다.
 *
 * 표 구분은 헤더 내용으로 한다:
 *   `코드`   있음                    → 고객사A 표 (키: 코드)
 *   `제품명` 있음                    → 고객사C 표 (키: 제품명 + 규격)
 *   `품목`+`품명` 있고 `코드` 없음    → 고객사B 표 (키: 규격)
 *
 * @return {{고객사A:Object, 고객사B:Object, 고객사C:Object, 단위중량:Object, 경고:string[]}}
 */
function 변환규칙_로드() {
  const 결과 = { 고객사A: {}, 고객사B: {}, 고객사C: {}, 단위중량: {}, 경고: [] };

  _격자모음(설정값('시트.변환규칙')).forEach(function (덩이) {
    const 격자 = 덩이.격자;

    for (let r = 0; r < 격자.length; r++) {
      const 행 = _뒤빈칸제거(격자[r]);
      if (!행.length) continue;

      let 종류 = null;
      if (_헤더포함(행, ['코드', '품목코드', '규격'])) 종류 = '고객사A';
      else if (_헤더포함(행, ['제품명', '규격', '품목코드'])) 종류 = '고객사C';
      else if (_헤더포함(행, ['품목', '품명', '품목코드', '규격'])) 종류 = '고객사B';
      if (!종류) continue;

      // 헤더 다음 행부터 빈 행이나 다음 표 헤더가 나올 때까지 읽는다
      const 헤더 = 행;
      let i = r + 1;
      for (; i < 격자.length; i++) {
        const 데이터 = _뒤빈칸제거(격자[i]);
        if (!데이터.length) break;
        if (_헤더포함(데이터, ['품목코드'])) break;
        _변환규칙행_담기(종류, 헤더, 데이터, 결과, 덩이.탭, i + 1);
      }
      r = i - 1; // 읽은 만큼 건너뛴다
    }
  });

  ['고객사A', '고객사B', '고객사C'].forEach(function (c) {
    if (Object.keys(결과[c]).length === 0) {
      결과.경고.push(c + ' 변환규칙 표를 찾지 못했습니다');
    }
  });

  return 결과;
}

/** 변환규칙 한 행을 결과에 담는다. */
function _변환규칙행_담기(종류, 헤더, 데이터, 결과, 탭명, 행번호) {
  function 값(이름) {
    const i = _열찾기(헤더, 이름);
    return i >= 0 ? String(데이터[i] == null ? '' : 데이터[i]).trim() : '';
  }

  const 품목코드 = 값('품목코드');
  const 규격 = 규격정규화(값('규격'));
  const 어디 = 탭명 + '!' + 행번호 + '행';

  if (종류 === '고객사A') {
    // 이 표에서는 `품명` 열이 딥다이브 품목명을 담고 있다 (예: AVSS 0.3SQ)
    const 코드 = 값('코드');
    if (!코드) return;
    결과.고객사A[키정규화(코드)] = {
      품목: 값('품명'), 품목코드: 품목코드, 규격: 규격, 출처: 어디
    };
    if (!값('품명')) 결과.경고.push('고객사A ' + 코드 + ' 품목명이 비어 있습니다 (' + 어디 + ')');

  } else if (종류 === '고객사B') {
    // 품명은 전부 `연동집합선` 이라 구분에 못 쓴다. 규격이 키다.
    if (!규격) return;
    결과.고객사B[규격] = {
      품목: 값('품목'), 품목코드: 품목코드, 규격: 규격, 출처: 어디
    };
    if (!값('품목')) 결과.경고.push('고객사B ' + 규격 + ' 품목명이 비어 있습니다 (' + 어디 + ')');

  } else if (종류 === '고객사C') {
    const 제품명 = 값('제품명');
    if (!제품명 && !규격) return;
    결과.고객사C[키정규화(제품명) + '|' + 규격] = {
      품목: 값('품목'), 품목코드: 품목코드, 규격: 규격, 출처: 어디
    };
    if (!값('품목')) 결과.경고.push('고객사C ' + 제품명 + ' 품목명이 비어 있습니다 (' + 어디 + ')');

    // 단위중량(보빈 1개 무게). 검산에 쓴다. 규격 기준으로 따로 모아 둔다.
    const w = 숫자파싱(값('중량'));
    if (w) 결과.단위중량[규격] = w;
  }
}

/** 규격의 단위중량. 모르면 null. */
function 단위중량(규칙, 규격) {
  const v = 규칙.단위중량[규격정규화(규격)];
  return v === undefined ? null : v;
}

// ─────────────────────────────────────────────────────────────
// 양식 시트 (출력 레이아웃)
// ─────────────────────────────────────────────────────────────

/**
 * 양식 시트를 읽어 고객사별 탭 레이아웃을 만든다.
 *
 * 시트 구조는 고객사마다 두 행이다:
 *   1행: 병합 라벨   `고객사 A` … (빈 열) … `딥다이브` …
 *   2행: 필드명      발주코드 품명 수량 중량 일자 │ (빈 열) │ 품목 품목코드 규격 수량 중량 일자
 *
 * 병합 셀은 getValues() 에서 좌상단만 값이 오므로 라벨 행으로는 블록 너비를 알 수 없다.
 * 그래서 **필드명 행의 빈 열을 기준으로 좌우를 가른다.**
 *
 * @return {{레이아웃:Object, 경고:string[]}}
 */
function 양식_로드() {
  const 결과 = { 레이아웃: {}, 경고: [] };

  _격자모음(설정값('시트.양식')).forEach(function (덩이) {
    const 격자 = 덩이.격자;

    for (let r = 0; r < 격자.length; r++) {
      const 라벨행 = _뒤빈칸제거(격자[r]);
      if (!라벨행.length) continue;

      // 라벨 행에서 고객사를 찾는다 (`고객사 A` → 고객사A. 공백 차이는 키정규화가 흡수)
      let 고객사 = null;
      for (let c = 0; c < 라벨행.length && !고객사; c++) {
        const k = 키정규화(라벨행[c]);
        고객사목록.forEach(function (후보) {
          if (k === 키정규화(후보)) 고객사 = 후보;
        });
      }
      if (!고객사) continue;
      if (r + 1 >= 격자.length) continue;

      const 필드행 = _뒤빈칸제거(격자[r + 1]);
      const 빈칸 = 필드행.indexOf('');
      if (빈칸 < 0) {
        결과.경고.push(고객사 + ' 양식에 좌우를 가르는 빈 열이 없습니다 (' + 덩이.탭 + '!' + (r + 2) + '행)');
        continue;
      }

      const 왼쪽 = 필드행.slice(0, 빈칸).filter(function (v) { return v !== ''; });
      const 오른쪽 = 필드행.slice(빈칸).filter(function (v) { return v !== ''; });
      const 오른쪽라벨 = 라벨행.slice(빈칸).filter(function (v) { return v !== ''; })[0] || '딥다이브';

      결과.레이아웃[고객사] = {
        왼쪽라벨: 라벨행.filter(function (v) { return v !== ''; })[0],
        오른쪽라벨: 오른쪽라벨,
        왼쪽: 왼쪽,
        오른쪽: 오른쪽,
        구분열: 빈칸,                       // 0-based. 왼쪽 블록 폭과 같다
        전체폭: 빈칸 + 1 + 오른쪽.length,
        출처: 덩이.탭 + '!' + (r + 2) + '행'
      };
      r = r + 1; // 필드명 행은 다시 보지 않는다
    }
  });

  고객사목록.forEach(function (c) {
    if (!결과.레이아웃[c]) 결과.경고.push(c + ' 양식 블록을 찾지 못했습니다');
  });

  return 결과;
}

// ─────────────────────────────────────────────────────────────
// 검증
// ─────────────────────────────────────────────────────────────

/**
 * Phase 1 검증용. 두 시트를 읽어 결과를 로그로 뿜는다.
 * 편집기에서 이 함수를 실행하고 실행 로그를 보면 된다.
 *
 * 대화상자는 띄우지 않는다 (편집기 실행 시 매달림 방지). 팝업이 필요하면 메뉴용 래퍼를 쓴다.
 */
function 규칙_로드_테스트() {
  const 줄 = [];
  function p(s) { 줄.push(s); Logger.log(s); }

  p('===== 변환규칙 =====');
  const 규칙 = 변환규칙_로드();
  ['고객사A', '고객사B', '고객사C'].forEach(function (c) {
    const keys = Object.keys(규칙[c]);
    p(c + ': ' + keys.length + '건');
    keys.forEach(function (k) {
      const v = 규칙[c][k];
      p('   ' + k + '  ->  품목=' + (v.품목 || '(빈칸)') +
        ' / 품목코드=' + v.품목코드 + ' / 규격=' + v.규격);
    });
  });
  p('단위중량: ' + JSON.stringify(규칙.단위중량));

  p('');
  p('===== 양식 (출력 레이아웃) =====');
  const 양식 = 양식_로드();
  고객사목록.forEach(function (c) {
    const L = 양식.레이아웃[c];
    if (!L) { p(c + ': 없음'); return; }
    p(c + '  (' + L.출처 + ')  전체 ' + L.전체폭 + '열, 구분열 index=' + L.구분열);
    p('   왼쪽   [' + L.왼쪽라벨 + '] ' + L.왼쪽.join(' | '));
    p('   오른쪽 [' + L.오른쪽라벨 + '] ' + L.오른쪽.join(' | '));
  });

  p('');
  p('===== 규격 정규화 확인 =====');
  ['7/0.26', '7/0.32', '19/0.19', '19/0.16', '24/0.19', '16/0.19', '30/0.173', '37/0.260']
    .forEach(function (s) { p('   ' + s + ' -> ' + 규격정규화(s)); });

  p('');
  p('===== 발주코드 접미사 제거 확인 =====');
  ['ZWCSS-00030-P', 'ZWCSS-00050-P', 'ZWCSS-00200'].forEach(function (s) {
    p('   ' + s + ' -> ' + 발주코드에서코드(s));
  });

  p('');
  const 경고 = 규칙.경고.concat(양식.경고);
  if (경고.length) {
    p('===== 경고 ' + 경고.length + '건 =====');
    경고.forEach(function (w) { p('   ! ' + w); });
  } else {
    p('경고 없음');
  }

  return 줄.join('\n');
}

/** 시트 메뉴용 래퍼. 결과를 팝업으로 보여준다. */
function 규칙_로드_테스트_메뉴() {
  const 결과 = 규칙_로드_테스트();
  const ui = SpreadsheetApp.getUi();
  ui.alert('규칙 로드 테스트', 결과, ui.ButtonSet.OK);
}
