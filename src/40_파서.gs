/**
 * 40_파서.gs — 고객사별 표 해석
 *
 * 입력: 30_추출.gs 의 결과 {표들, 줄들, 원문}
 * 출력: {행들: [{원본필드…}], 합계: {...}, 월힌트: 'YYYY-MM'|null, 경고: []}
 *
 * 출력의 `행들` 각 원소는 양식 시트의 **왼쪽 블록(고객사 원본)** 필드를 담는다.
 *   고객사A: 발주코드 품명 수량 중량 일자
 *   고객사B: 품명 규격 중량
 *   고객사C: 제품명 규격 수량 중량
 *
 * ── 실측으로 확인한 것 (Phase 2) ──
 * Drive OCR·PDF 변환은 표 구조를 잃고 **셀 하나당 한 줄**로 내보낸다:
 *     연동집합선 / 7/0.26 / 7,980 / 연동집합선 / 19/0.19 / …
 * 그래서 고정 위치를 쓰지 않고 **규격 패턴이 나온 줄을 기준(anchor)** 으로 앞뒤를 잡는다.
 * 표가 제대로 온 경우(docx·xlsx·메일 HTML)에는 표 경로를 쓴다. 두 경로를 모두 지원한다.
 */

// ─────────────────────────────────────────────────────────────
// 공통 패턴
// ─────────────────────────────────────────────────────────────

/** 규격 `7/0.26` `30/0.173` `37/0.260` */
const _규격패턴 = /(\d+)\s*\/\s*(\d*\.?\d+)/;
/** 줄 전체가 규격인 경우 */
const _규격만 = /^\s*\d+\s*\/\s*\d*\.?\d+\s*$/;
/** 줄 전체가 숫자(천단위 콤마 허용) */
const _숫자만 = /^\s*-?[\d,]+(\.\d+)?\s*$/;
/** 합계·소계 라벨 */
const _합계라벨 = /^\s*(합\s*계|소\s*계|총\s*계|계)\s*$/;
/** `20260908` 또는 `2026 년 09 월 10 일` 또는 `2026-09-10` */
const _일자패턴8 = /\b(20\d{2})(0[1-9]|1[0-2])(0[1-9]|[12]\d|3[01])\b/;
const _일자패턴한글 = /(20\d{2})\s*년\s*(\d{1,2})\s*월(?:\s*(\d{1,2})\s*일)?/;
/** `9월` `09월` — 연도 없이 월만 */
const _월만패턴 = /(?:^|[^\d])(\d{1,2})\s*월/;

/** 문자열에서 모든 숫자를 뽑는다 (천단위 콤마 처리). */
function _줄에서숫자들(s) {
  const out = [];
  const re = /-?\d[\d,]*(?:\.\d+)?/g;
  let m;
  while ((m = re.exec(String(s || ''))) !== null) {
    const n = 숫자파싱(m[0]);
    if (n !== null) out.push(n);
  }
  return out;
}

/** 원문에서 'YYYY-MM' 을 뽑는다. 못 찾으면 null. */
function 월힌트추출(원문, 파일명) {
  const 후보 = [String(원문 || ''), String(파일명 || '')];

  for (let i = 0; i < 후보.length; i++) {
    let m = 후보[i].match(_일자패턴8);
    if (m) return m[1] + '-' + m[2];

    m = 후보[i].match(_일자패턴한글);
    if (m) return m[1] + '-' + ('0' + m[2]).slice(-2);
  }

  // 연도 없이 월만 있는 경우 (파일명 `고객사B 9월 발주서.png`). 연도는 올해로 본다.
  for (let i = 0; i < 후보.length; i++) {
    const m = 후보[i].match(_월만패턴);
    if (m) {
      const 월 = parseInt(m[1], 10);
      if (월 >= 1 && 월 <= 12) {
        return new Date().getFullYear() + '-' + ('0' + 월).slice(-2);
      }
    }
  }
  return null;
}

/** 결과 껍데기 */
function _파서결과() {
  return { 행들: [], 합계: {}, 월힌트: null, 경고: [], 경로: '' };
}

/**
 * 고객사별 파서 진입점.
 * @param {string} 고객사 '고객사A' | '고객사B' | '고객사C'
 * @param {Object} 추출결과 30_추출.gs 의 결과
 * @param {Object} 규칙 변환규칙_로드() 결과 (고객사C 숫자 판별에 단위중량이 필요)
 */
function 파싱(고객사, 추출결과, 규칙) {
  const r = 추출결과 || _추출결과();
  if (고객사 === '고객사A') return _파싱_A(r);
  if (고객사 === '고객사B') return _파싱_B(r);
  if (고객사 === '고객사C') return _파싱_C(r, 규칙);

  const out = _파서결과();
  out.경고.push('알 수 없는 고객사: ' + 고객사);
  return out;
}

// ─────────────────────────────────────────────────────────────
// 고객사 A — 발주코드 품명 수량 중량 일자
// ─────────────────────────────────────────────────────────────

/**
 * 고객사 A 는 메일 본문 표 또는 docx 표로 온다 (표 경로가 주). 컬럼은
 *   업체코드 업체명 코드 발주코드 품명 수량 중량 일자 출고코드 출고처
 * 이고, **납기 여러 블록**으로 나뉘어 블록마다 끝에 `합계` 행이 붙는다.
 *
 * 합계 행은 데이터에서 빼고, 블록별 합계를 검산용으로 모아 둔다.
 */
function _파싱_A(추출결과) {
  const out = _파서결과();
  out.월힌트 = 월힌트추출(추출결과.원문, 추출결과.메타 && 추출결과.메타.파일명);

  const 표 = _표찾기(추출결과.표들, ['발주코드', '수량', '중량']);
  if (표) {
    out.경로 = '표';
    _파싱_A_표(표, out);
  } else {
    out.경로 = '줄';
    _파싱_A_줄(추출결과.줄들, out);
  }

  if (!out.행들.length) out.경고.push('고객사A 데이터 행을 찾지 못했습니다');
  return out;
}

function _파싱_A_표(표, out) {
  const 헤더 = 표.헤더;
  const idx = {
    발주코드: _열찾기(헤더, '발주코드'),
    코드: _열찾기(헤더, '코드'),
    품명: _열찾기(헤더, '품명'),
    수량: _열찾기(헤더, '수량'),
    중량: _열찾기(헤더, '중량'),
    일자: _열찾기(헤더, '일자'),
  };

  const 블록합계 = [];
  let 현재블록 = { 수량: 0, 중량: 0, 행수: 0 };

  표.데이터.forEach(function (행) {
    // 합계 행인가 — 어느 칸에든 `합계`/`소계` 라벨이 있으면 그렇게 본다
    const 합계칸 = 행.filter(function (v) { return _합계라벨.test(v); });
    if (합계칸.length) {
      const 숫자들 = _줄에서숫자들(행.join(' '));
      블록합계.push({
        수량: 숫자들.length > 0 ? 숫자들[0] : null,
        중량: 숫자들.length > 1 ? 숫자들[1] : null,
        누적: 현재블록,
      });
      현재블록 = { 수량: 0, 중량: 0, 행수: 0 };
      return;
    }

    const 발주코드 = idx.발주코드 >= 0 ? 행[idx.발주코드] : '';
    const 코드 = idx.코드 >= 0 ? 행[idx.코드] : '';
    if (!발주코드 && !코드) return; // 빈 행

    const 수량 = idx.수량 >= 0 ? 숫자파싱(행[idx.수량]) : null;
    const 중량 = idx.중량 >= 0 ? 숫자파싱(행[idx.중량]) : null;

    out.행들.push({
      발주코드: 발주코드 || 코드,
      품명: idx.품명 >= 0 ? 행[idx.품명] : '',
      수량: 수량,
      중량: 중량,
      일자: idx.일자 >= 0 ? String(행[idx.일자] || '').trim() : '',
    });

    if (수량) 현재블록.수량 += 수량;
    if (중량) 현재블록.중량 += 중량;
    현재블록.행수++;
  });

  out.합계.블록들 = 블록합계;
}

/**
 * 줄 경로 — 표가 깨져서 셀 하나당 한 줄로 온 경우.
 * `ZWCSS-...-P` 형태의 발주코드를 기준으로 앞뒤를 잡는다.
 * (고객사 A 실물 파일이 아직 없어 **미검증**이다. 실제 메일이 오면 여기를 맞춘다.)
 */
function _파싱_A_줄(줄들, out) {
  const 줄 = 줄들 || [];
  const 코드패턴 = /^[A-Za-z]{2,}-\d{3,}(-[A-Za-z])?$/;

  줄.forEach(function (s, i) {
    if (!코드패턴.test(s.trim())) return;
    // 발주코드 뒤로 품명·수량·중량·일자가 이어진다고 본다
    const 뒤 = 줄.slice(i + 1, i + 6);
    const 숫자들 = [];
    let 품명 = '';
    let 일자 = '';
    뒤.forEach(function (t) {
      if (_일자패턴8.test(t)) { 일자 = t.match(_일자패턴8)[0]; return; }
      if (_숫자만.test(t)) { const n = 숫자파싱(t); if (n !== null) 숫자들.push(n); return; }
      if (!품명 && !_규격만.test(t)) 품명 = t;
    });
    out.행들.push({
      발주코드: s.trim(),
      품명: 품명,
      수량: 숫자들.length > 0 ? 숫자들[0] : null,
      중량: 숫자들.length > 1 ? 숫자들[1] : null,
      일자: 일자,
    });
  });

  if (out.행들.length) {
    out.경고.push('고객사A 를 줄 경로로 해석했습니다 (표가 없었음). 값 배치를 확인하세요');
  }
}

// ─────────────────────────────────────────────────────────────
// 고객사 B — 품명 규격 중량
// ─────────────────────────────────────────────────────────────

/**
 * 고객사 B 는 이미지(PNG)로 온다. Drive OCR 이 셀 하나당 한 줄로 내보낸다:
 *     품명 / 규격 / 딥다이브 / 연동집합선 / 7/0.26 / 7,980 / 연동집합선 / …
 * **규격만 있는 줄을 기준**으로 앞줄=품명, 뒷줄=중량 으로 잡는다.
 * 마지막에 `소계` 라벨 + 값이 붙으므로 검산용으로 챙긴다.
 */
function _파싱_B(추출결과) {
  const out = _파서결과();
  out.월힌트 = 월힌트추출(추출결과.원문, 추출결과.메타 && 추출결과.메타.파일명);

  const 표 = _표찾기(추출결과.표들, ['품명', '규격']);
  if (표) {
    out.경로 = '표';
    _파싱_B_표(표, out);
  } else {
    out.경로 = '줄';
    _파싱_B_줄(추출결과.줄들, out);
  }

  if (!out.행들.length) out.경고.push('고객사B 데이터 행을 찾지 못했습니다');
  return out;
}

function _파싱_B_표(표, out) {
  const 헤더 = 표.헤더;
  const i품명 = _열찾기(헤더, '품명');
  const i규격 = _열찾기(헤더, '규격');
  // 중량 열은 `중량` 이거나 `딥다이브`(발주 대상 열) 이거나, 없으면 마지막 숫자 열
  let i중량 = _열찾기(헤더, '중량');
  if (i중량 < 0) i중량 = _열찾기(헤더, '딥다이브');

  표.데이터.forEach(function (행) {
    if (행.some(function (v) { return _합계라벨.test(v); })) {
      const 숫자들 = _줄에서숫자들(행.join(' '));
      if (숫자들.length) out.합계.소계 = 숫자들[숫자들.length - 1];
      return;
    }
    const 규격 = i규격 >= 0 ? 행[i규격] : '';
    if (!_규격패턴.test(규격)) return;

    const 중량 = i중량 >= 0 ? 숫자파싱(행[i중량]) : _마지막숫자(행);
    out.행들.push({
      품명: i품명 >= 0 ? 행[i품명] : '',
      규격: String(규격).trim(),
      중량: 중량,
    });
  });
}

function _파싱_B_줄(줄들, out) {
  const 줄 = (줄들 || []).map(function (s) { return String(s).trim(); });

  줄.forEach(function (s, i) {
    if (!_규격만.test(s)) return;

    const 앞 = i > 0 ? 줄[i - 1] : '';
    const 뒤 = i + 1 < 줄.length ? 줄[i + 1] : '';

    // 앞줄이 품명 후보인가 — 숫자나 다른 규격이면 품명이 아니다
    const 품명 = (앞 && !_숫자만.test(앞) && !_규격만.test(앞) && !_합계라벨.test(앞)) ? 앞 : '';
    const 중량 = _숫자만.test(뒤) ? 숫자파싱(뒤) : null;

    if (중량 === null) {
      out.경고.push('고객사B 규격 ' + s + ' 뒤에 중량 숫자가 없습니다 (뒷줄: "' + 뒤 + '")');
      return;
    }
    out.행들.push({ 품명: 품명, 규격: s, 중량: 중량 });
  });

  // 소계 — 라벨 줄 다음의 숫자
  for (let i = 0; i < 줄.length; i++) {
    if (_합계라벨.test(줄[i])) {
      for (let j = i + 1; j < Math.min(i + 3, 줄.length); j++) {
        if (_숫자만.test(줄[j])) { out.합계.소계 = 숫자파싱(줄[j]); break; }
      }
      // 같은 줄에 붙어 있는 경우도 본다
      if (out.합계.소계 === undefined) {
        const n = _줄에서숫자들(줄[i]);
        if (n.length) out.합계.소계 = n[n.length - 1];
      }
      break;
    }
  }
}

// ─────────────────────────────────────────────────────────────
// 고객사 C — 제품명 규격 수량 중량
// ─────────────────────────────────────────────────────────────

/**
 * 고객사 C 는 PDF 로 온다. 텍스트 레이어를 쓰지만 표 구조가 없어 값이 줄에 흩어진다:
 *     20: AVSS 2.0SQ 37/0.260
 *     22: 24,500 16 6,976이 하 여 백
 *
 * 열 순서는 `순번 품명 규격 조·장 수량 금액(원) 비고` 이고 **중량이 `비고` 열에 있다.**
 * 금액이 비어 있으면 숫자가 3개(조장·수량·중량), 채워져 있으면 4개가 된다.
 * 그래서 위치로 세지 않고 **`중량 = 수량 × 단위중량`** 을 만족하는 쌍을 찾는다.
 * (37/0.260 → 436, 16 × 436 = 6,976). 단위중량을 모르면 위치 규칙으로 물러난다.
 */
function _파싱_C(추출결과, 규칙) {
  const out = _파서결과();
  out.월힌트 = 월힌트추출(추출결과.원문, 추출결과.메타 && 추출결과.메타.파일명);

  const 표 = _표찾기(추출결과.표들, ['규격', '수량']);
  if (표) {
    out.경로 = '표';
    _파싱_C_표(표, out);
  } else {
    out.경로 = '줄';
    _파싱_C_줄(추출결과.줄들, out, 규칙);
  }

  if (!out.행들.length) out.경고.push('고객사C 데이터 행을 찾지 못했습니다');
  return out;
}

function _파싱_C_표(표, out) {
  const 헤더 = 표.헤더;
  const i제품 = _열찾기(헤더, '제품명') >= 0 ? _열찾기(헤더, '제품명') : _열찾기(헤더, '품명');
  const i규격 = _열찾기(헤더, '규격');
  const i수량 = _열찾기(헤더, '수량');
  // 중량은 `중량` 열이 없으면 `비고` 열에 들어 있다 (실측)
  let i중량 = _열찾기(헤더, '중량');
  if (i중량 < 0) i중량 = _열찾기(헤더, '비고');

  표.데이터.forEach(function (행) {
    if (행.some(function (v) { return _합계라벨.test(v); })) return;
    const 규격 = i규격 >= 0 ? 행[i규격] : '';
    if (!_규격패턴.test(규격)) return;
    out.행들.push({
      제품명: i제품 >= 0 ? 행[i제품] : '',
      규격: String(규격).trim(),
      수량: i수량 >= 0 ? 숫자파싱(행[i수량]) : null,
      중량: i중량 >= 0 ? 숫자파싱(행[i중량]) : null,
    });
  });
}

function _파싱_C_줄(줄들, out, 규칙) {
  const 줄 = (줄들 || []).map(function (s) { return String(s).trim(); });

  // 1) 품목 후보 — `AVSS 2.0SQ 37/0.260` 처럼 제품명 + 규격이 한 줄에 있는 것
  const 품목들 = [];
  줄.forEach(function (s, i) {
    const m = s.match(/^(.*?)\s*(\d+\s*\/\s*\d*\.?\d+)\s*$/);
    if (!m) return;
    const 제품명 = m[1].trim();
    if (!제품명) return;                                  // 규격만 있는 줄은 제외
    if (_합계라벨.test(제품명)) return;
    if (/순번|품\s*명|규\s*격/.test(제품명)) return;        // 헤더 줄 제외
    품목들.push({ 줄번호: i, 제품명: 제품명, 규격: m[2].replace(/\s/g, '') });
  });

  // 2) 숫자 묶음 후보 — 숫자가 2개 이상인 줄.
  //
  // 여기서 걸러내지 않으면 엉뚱한 줄이 먼저 잡힌다. 실측 PDF 에 있던 함정들:
  //   `2026 년 09 월 10 일` → [2026, 9, 10]     발주일자
  //   `123-45-67890`        → [123, 45, 67890]  등록번호
  //   `AVSS 2.0SQ 37/0.260` → [2.0, 37, 0.260]  품목행 자기 자신
  const 품목줄번호 = {};
  품목들.forEach(function (p) { 품목줄번호[p.줄번호] = true; });

  const 숫자줄들 = [];
  줄.forEach(function (s, i) {
    if (품목줄번호[i]) return;                                  // 품목행 자신 제외
    if (/전화|팩\s*스|연\s*락|등록번호|사업자|Rev/i.test(s)) return;
    if (/^\s*순번/.test(s)) return;
    if (/\d\s*년|\d\s*월|\d\s*일/.test(s)) return;              // 날짜 줄 제외
    const nums = _줄에서숫자들(s).filter(function (n) { return n > 0; });
    if (nums.length >= 2) 숫자줄들.push({ 줄번호: i, 숫자들: nums });
  });

  // 3) 품목마다 **자기 뒤에 오는 가장 가까운** 숫자 줄을 쓴다.
  //    이미 다른 품목이 쓴 줄은 건너뛴다 (여러 행 발주서 대응).
  const 사용됨 = {};
  품목들.forEach(function (품목) {
    let 숫자묶음 = null;
    for (let k = 0; k < 숫자줄들.length; k++) {
      if (숫자줄들[k].줄번호 > 품목.줄번호 && !사용됨[숫자줄들[k].줄번호]) {
        숫자묶음 = 숫자줄들[k];
        break;
      }
    }
    if (!숫자묶음) {
      out.경고.push('고객사C ' + 품목.제품명 + ' 뒤에서 숫자 줄을 찾지 못했습니다');
      return;
    }
    사용됨[숫자묶음.줄번호] = true;
    const 판별 = _수량중량판별(숫자묶음.숫자들, 품목.규격, 규칙);
    if (판별.경고) out.경고.push('고객사C ' + 품목.제품명 + ' ' + 판별.경고);

    out.행들.push({
      제품명: 품목.제품명,
      규격: 품목.규격,
      수량: 판별.수량,
      중량: 판별.중량,
      조장: 판별.조장,
    });
  });
}

/**
 * 숫자 묶음에서 수량·중량을 가려낸다.
 *
 * 1순위: `중량 = 수량 × 단위중량` 을 만족하는 쌍 (위치에 의존하지 않는다)
 * 2순위: 위치 규칙 — 조장은 첫째, 수량은 둘째, 중량은 마지막
 */
function _수량중량판별(숫자들, 규격, 규칙) {
  const 단위 = 규칙 ? 단위중량(규칙, 규격) : null;

  if (단위) {
    for (let i = 0; i < 숫자들.length; i++) {
      for (let j = 0; j < 숫자들.length; j++) {
        if (i === j) continue;
        if (Math.abs(숫자들[j] - 숫자들[i] * 단위) < 0.5) {
          const 나머지 = 숫자들.filter(function (_, k) { return k !== i && k !== j; });
          return {
            수량: 숫자들[i],
            중량: 숫자들[j],
            조장: 나머지.length ? 나머지[0] : null,
            근거: '단위중량 ' + 단위 + ' 로 판별 (' + 숫자들[i] + ' × ' + 단위 + ' = ' + 숫자들[j] + ')',
          };
        }
      }
    }
  }

  return {
    수량: 숫자들.length > 1 ? 숫자들[1] : null,
    중량: 숫자들.length ? 숫자들[숫자들.length - 1] : null,
    조장: 숫자들.length ? 숫자들[0] : null,
    근거: '위치 규칙 (조장=첫째, 수량=둘째, 중량=마지막)',
    경고: 단위
      ? '단위중량 ' + 단위 + ' 로 맞는 쌍을 못 찾아 위치 규칙을 썼습니다: [' + 숫자들.join(', ') + ']'
      : '규격 ' + 규격 + ' 의 단위중량을 몰라 위치 규칙을 썼습니다: [' + 숫자들.join(', ') + ']',
  };
}

// ─────────────────────────────────────────────────────────────
// 표 찾기 유틸
// ─────────────────────────────────────────────────────────────

/**
 * 표 목록에서 주어진 헤더를 가진 표를 찾아 {헤더, 데이터} 로 돌려준다.
 * 메일 본문의 레이아웃용 표를 걸러내려고 **헤더 내용으로** 판단한다.
 */
function _표찾기(표들, 필요헤더) {
  const 목록 = 표들 || [];
  for (let t = 0; t < 목록.length; t++) {
    const 표 = 목록[t];
    for (let r = 0; r < 표.length; r++) {
      const 행 = 표[r].map(function (v) { return String(v == null ? '' : v).trim(); });
      if (_헤더포함(행, 필요헤더)) {
        return { 헤더: 행, 데이터: 표.slice(r + 1), 표번호: t, 헤더행: r };
      }
    }
  }
  return null;
}

/** 행에서 마지막 숫자 값 */
function _마지막숫자(행) {
  for (let i = 행.length - 1; i >= 0; i--) {
    const n = 숫자파싱(행[i]);
    if (n !== null) return n;
  }
  return null;
}
