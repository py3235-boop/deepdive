/**
 * 50_매핑.gs — 변환규칙 적용
 *
 * 파서가 만든 왼쪽 블록(고객사 원본)을 받아 오른쪽 블록(딥다이브)을 채운다.
 *
 * 변환규칙이 실제로 바꾸는 것은 **품목 · 품목코드 · 규격** 세 개뿐이다.
 * 수량 · 중량 · 일자는 왼쪽 값을 그대로 오른쪽에 옮긴다.
 *
 * 매핑 실패는 예외를 던지지 않는다. 행 단위로 성공/실패를 표시해서 올려보내고,
 * 실패 행은 상위 계층이 미매핑 탭으로 보낸다.
 */

/**
 * @param {string} 고객사
 * @param {Object} 파서결과 40_파서.gs 의 결과
 * @param {Object} 규칙 변환규칙_로드() 결과
 * @return {{행들:Array, 성공수:number, 실패수:number, 경고:string[]}}
 *   행들 각 원소: { 원본:{...}, 변환:{품목,품목코드,규격,수량,중량,일자}, 성공, 사유, 근거 }
 */
function 매핑(고객사, 파서결과, 규칙) {
  const out = { 행들: [], 성공수: 0, 실패수: 0, 경고: [] };

  (파서결과.행들 || []).forEach(function (원본) {
    const 결과 = _행매핑(고객사, 원본, 규칙);
    out.행들.push(결과);
    if (결과.성공) out.성공수++; else out.실패수++;
  });

  return out;
}

/** 한 행을 매핑한다. */
function _행매핑(고객사, 원본, 규칙) {
  if (고객사 === '고객사A') return _행매핑_A(원본, 규칙);
  if (고객사 === '고객사B') return _행매핑_B(원본, 규칙);
  if (고객사 === '고객사C') return _행매핑_C(원본, 규칙);
  return { 원본: 원본, 변환: null, 성공: false, 사유: '알 수 없는 고객사: ' + 고객사 };
}

/**
 * 고객사 A — 발주코드로 찾는다.
 * 양식이 지정한 키는 `발주코드`(`ZWCSS-00030-P`) 인데 변환규칙의 키는 `코드`(`ZWCSS-00030`) 이므로
 * 접미사를 떼고 찾는다.
 */
function _행매핑_A(원본, 규칙) {
  const 코드 = 발주코드에서코드(원본.발주코드);
  const 찾음 = 규칙.고객사A[키정규화(코드)];

  if (!찾음) {
    return {
      원본: 원본, 변환: null, 성공: false,
      사유: '변환규칙에 코드 ' + (코드 || '(빈칸)') + ' 가 없습니다',
    };
  }

  return {
    원본: 원본,
    변환: {
      품목: 찾음.품목,
      품목코드: 찾음.품목코드,
      규격: 찾음.규격,
      수량: 원본.수량,
      중량: 원본.중량,
      일자: 원본.일자,
    },
    성공: true,
    근거: '코드 ' + 코드 + ' → ' + 찾음.출처,
    품목명누락: !찾음.품목,
  };
}

/**
 * 고객사 B — 규격으로 찾는다.
 * 품명은 전부 `연동집합선` 이라 구분에 쓸 수 없다. 발주서 표기(`7/0.26`)와
 * 변환규칙 표기(`7/0.260`)가 다르므로 양쪽을 규격정규화로 맞춘 뒤 비교한다.
 */
function _행매핑_B(원본, 규칙) {
  const 규격 = 규격정규화(원본.규격);
  const 찾음 = 규칙.고객사B[규격];

  if (!찾음) {
    return {
      원본: 원본, 변환: null, 성공: false,
      사유: '변환규칙에 규격 ' + (규격 || '(빈칸)') + ' 가 없습니다',
    };
  }

  return {
    원본: 원본,
    변환: {
      품목: 찾음.품목,
      품목코드: 찾음.품목코드,
      규격: 찾음.규격,
      중량: 원본.중량,
    },
    성공: true,
    근거: '규격 ' + 규격 + ' → ' + 찾음.출처,
    품목명누락: !찾음.품목,
  };
}

/**
 * 고객사 C — 제품명 + 규격으로 찾는다.
 * 정확히 못 찾으면 같은 규격을 가진 항목으로 물러난다 (제품명 표기가 흔들릴 수 있으므로).
 */
function _행매핑_C(원본, 규칙) {
  const 규격 = 규격정규화(원본.규격);
  const 키 = 키정규화(원본.제품명) + '|' + 규격;
  let 찾음 = 규칙.고객사C[키];
  let 근거 = '제품명+규격 ' + 키;

  if (!찾음) {
    // 규격만으로 재시도
    const 키들 = Object.keys(규칙.고객사C);
    for (let i = 0; i < 키들.length; i++) {
      if (규칙.고객사C[키들[i]].규격 === 규격) {
        찾음 = 규칙.고객사C[키들[i]];
        근거 = '규격 ' + 규격 + ' 만으로 매칭 (제품명 "' + 원본.제품명 + '" 불일치)';
        break;
      }
    }
  }

  if (!찾음) {
    return {
      원본: 원본, 변환: null, 성공: false,
      사유: '변환규칙에 제품명 "' + 원본.제품명 + '" / 규격 ' + (규격 || '(빈칸)') + ' 가 없습니다',
    };
  }

  return {
    원본: 원본,
    변환: {
      품목: 찾음.품목,
      품목코드: 찾음.품목코드,
      규격: 찾음.규격,
      수량: 원본.수량,
      중량: 원본.중량,
    },
    성공: true,
    근거: 근거 + ' → ' + 찾음.출처,
    품목명누락: !찾음.품목,
  };
}

/**
 * 양식 레이아웃에 맞춰 한 행을 [왼쪽…, '', 오른쪽…] 배열로 만든다.
 * 70_기록.gs 가 이걸 그대로 시트에 쓴다.
 *
 * 필드명은 양식 시트에서 온 것이므로, 양식이 바뀌면 여기 코드를 고치지 않아도 따라간다.
 */
function 행을배열로(레이아웃, 매핑행) {
  const 왼쪽 = 레이아웃.왼쪽.map(function (필드) {
    return _필드값(매핑행.원본, 필드);
  });
  const 오른쪽 = 레이아웃.오른쪽.map(function (필드) {
    return 매핑행.변환 ? _필드값(매핑행.변환, 필드) : '';
  });
  return 왼쪽.concat(['']).concat(오른쪽);
}

/**
 * 필드명으로 값을 꺼낸다. 양식의 필드명과 파서의 키 이름이 다른 경우를 흡수한다.
 *   양식 `품명`  ↔ 고객사C 파서의 `제품명`
 *   양식 `제품명` ↔ 고객사A·B 파서의 `품명`
 */
function _필드값(객체, 필드) {
  if (!객체) return '';
  if (객체[필드] !== undefined && 객체[필드] !== null) return 객체[필드];

  const 별칭 = { 품명: ['제품명'], 제품명: ['품명'], 품목: ['품명', '제품명'] };
  const 후보들 = 별칭[필드] || [];
  for (let i = 0; i < 후보들.length; i++) {
    const v = 객체[후보들[i]];
    if (v !== undefined && v !== null) return v;
  }
  return '';
}
