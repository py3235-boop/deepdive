/**
 * 60_검산.gs — 추출·매핑 결과를 발주서 자체의 숫자로 검증한다.
 *
 * 이 프로젝트에서 검산이 가능한 이유: 발주서에 검산 장치가 이미 들어 있다.
 *   고객사A — 납기 블록마다 `합계` 행 (수량 합, 중량 합)
 *   고객사B — 마지막에 `소계` 행 (중량 합)
 *   공통    — 중량 = 수량 × 단위중량 (단위중량을 아는 규격만)
 *
 * 실측 예: 고객사B 7행 합 69,794 = 소계 69,794 / 고객사C 16 × 436 = 6,976
 *
 * 합계 대조가 틀리면 **치명적**으로 본다. 값을 잘못 옮긴 것이므로 그 건 전체를 보류한다.
 * 단위중량 대조는 참고용이다 (단위중량 자체가 시트 값이라 틀릴 수 있으므로).
 */

/** 검산 결과 껍데기 */
function _검산결과() {
  return { 통과: true, 치명적: false, 항목들: [], 요약: '' };
}

function _항목추가(결과, 이름, 기대, 실제, 치명적) {
  const 일치 = (기대 === null || 실제 === null)
    ? null
    : Math.abs(Number(기대) - Number(실제)) < 0.5;

  결과.항목들.push({
    이름: 이름,
    기대: 기대,
    실제: 실제,
    차이: (기대 === null || 실제 === null) ? null : Number(실제) - Number(기대),
    통과: 일치,
    치명적: !!치명적,
  });

  if (일치 === false) {
    결과.통과 = false;
    if (치명적) 결과.치명적 = true;
  }
}

/**
 * @param {string} 고객사
 * @param {Object} 파서결과 40_파서.gs 결과 (합계 정보가 여기 있다)
 * @param {Object} 매핑결과 50_매핑.gs 결과
 * @param {Object} 규칙 변환규칙_로드() 결과
 */
function 검산(고객사, 파서결과, 매핑결과, 규칙) {
  const 결과 = _검산결과();
  const 행들 = 매핑결과.행들 || [];

  // ── 1. 고객사B: 소계 대조 ──
  if (파서결과.합계 && 파서결과.합계.소계 !== undefined && 파서결과.합계.소계 !== null) {
    const 합 = 행들.reduce(function (a, r) {
      const w = 숫자파싱(r.원본.중량);
      return a + (w || 0);
    }, 0);
    _항목추가(결과, '소계(중량 합)', 파서결과.합계.소계, 합, true);
  }

  // ── 2. 고객사A: 블록별 합계 대조 ──
  if (파서결과.합계 && 파서결과.합계.블록들 && 파서결과.합계.블록들.length) {
    파서결과.합계.블록들.forEach(function (블록, i) {
      const 라벨 = (i + 1) + '차 블록';
      if (블록.수량 !== null && 블록.누적) {
        _항목추가(결과, 라벨 + ' 수량 합', 블록.수량, 블록.누적.수량, true);
      }
      if (블록.중량 !== null && 블록.누적) {
        _항목추가(결과, 라벨 + ' 중량 합', 블록.중량, 블록.누적.중량, true);
      }
    });
  }

  // ── 3. 공통: 중량 = 수량 × 단위중량 ──
  행들.forEach(function (r, i) {
    if (!r.성공 || !r.변환) return;
    const 수량 = 숫자파싱(r.변환.수량);
    const 중량 = 숫자파싱(r.변환.중량);
    if (수량 === null || 중량 === null) return; // 고객사B 처럼 수량이 없는 경우

    const 단위 = 단위중량(규칙, r.변환.규격);
    if (!단위) return;                            // 단위중량을 모르는 규격은 건너뛴다

    _항목추가(결과, (i + 1) + '행 ' + r.변환.규격 + ' 중량(=수량×' + 단위 + ')',
      수량 * 단위, 중량, false);
  });

  // ── 요약 ──
  const 실패 = 결과.항목들.filter(function (a) { return a.통과 === false; });
  if (!결과.항목들.length) {
    결과.요약 = '검산할 기준값이 없습니다 (합계 행도, 단위중량도 없음)';
  } else if (실패.length === 0) {
    결과.요약 = '검산 ' + 결과.항목들.length + '항목 전부 통과';
  } else {
    결과.요약 = '검산 실패 ' + 실패.length + '/' + 결과.항목들.length + '항목' +
      (결과.치명적 ? ' (치명적 — 이 건은 보류합니다)' : ' (참고용 항목만 불일치)');
  }

  return 결과;
}

/** 검산 결과를 사람이 읽을 줄로 */
function 검산_설명(검산결과) {
  const 줄 = [검산결과.요약];
  검산결과.항목들.forEach(function (a) {
    const 표시 = a.통과 === null ? '?' : (a.통과 ? 'OK' : 'FAIL');
    줄.push('   [' + 표시 + '] ' + a.이름 +
      ' — 기대 ' + a.기대 + ' / 실제 ' + a.실제 +
      (a.차이 ? ' (차이 ' + a.차이 + ')' : '') +
      (a.치명적 ? ' *치명적' : ''));
  });
  return 줄.join('\n');
}

// ─────────────────────────────────────────────────────────────
// Phase 3 통합 검증
// ─────────────────────────────────────────────────────────────

/**
 * 추출 → 파싱 → 매핑 → 검산 을 한 번에 돌린다.
 * 70_기록.gs 가 쓸 최종 형태를 만들어 돌려준다.
 *
 * @return {{고객사, 행들, 파서결과, 매핑결과, 검산결과, 레이아웃, 월힌트, 경고}}
 */
function 처리(고객사, 추출결과, 규칙, 양식) {
  const 파서결과 = 파싱(고객사, 추출결과, 규칙);
  const 매핑결과 = 매핑(고객사, 파서결과, 규칙);
  const 검산결과 = 검산(고객사, 파서결과, 매핑결과, 규칙);
  const 레이아웃 = 양식.레이아웃[고객사] || null;

  return {
    고객사: 고객사,
    파서결과: 파서결과,
    매핑결과: 매핑결과,
    검산결과: 검산결과,
    레이아웃: 레이아웃,
    월힌트: 파서결과.월힌트,
    경고: 파서결과.경고.concat(매핑결과.경고),
  };
}

/**
 * Phase 3 검증용. 드라이브 고객사 폴더의 파일을 처리해 좌우 표를 그대로 로그에 찍는다.
 * 왼쪽(고객사 원본)과 오른쪽(딥다이브 변환)을 나란히 보고 눈으로 대조하는 것이 목적이다.
 */
function 처리_테스트() {
  const 줄 = [];
  function p(s) { 줄.push(s); Logger.log(s); }

  const 규칙 = 변환규칙_로드();
  const 양식 = 양식_로드();

  고객사목록.forEach(function (고객사) {
    const 폴더ID = 설정전체()['폴더.' + 고객사];
    p('');
    p('##################  ' + 고객사 + '  ##################');
    if (!폴더ID) { p('  폴더 ID 설정 없음'); return; }

    const 목록 = 추출_폴더(폴더ID);
    if (!목록.length) { p('  (폴더가 비어 있습니다)'); return; }

    목록.forEach(function (항목) {
      p('');
      p('── ' + 항목.파일.getName());
      if (!항목.결과.성공) {
        p('   추출 실패: ' + (항목.결과.메타.실패사유 || '?'));
        return;
      }

      const R = 처리(고객사, 항목.결과, 규칙, 양식);
      p('   파싱 경로=' + R.파서결과.경로 +
        ' / 행 ' + R.파서결과.행들.length + '개' +
        ' / 매핑 성공 ' + R.매핑결과.성공수 + ' 실패 ' + R.매핑결과.실패수 +
        ' / 월힌트 ' + (R.월힌트 || '(없음)'));

      if (!R.레이아웃) {
        p('   ! 양식 레이아웃이 없어 표를 만들 수 없습니다');
      } else {
        const L = R.레이아웃;
        p('');
        p('   ' + L.왼쪽.join(' | ') + '   ‖   ' + L.오른쪽.join(' | '));
        p('   ' + new Array(L.왼쪽.join(' | ').length + 1).join('-') +
          '---+---' + new Array(L.오른쪽.join(' | ').length + 1).join('-'));
        R.매핑결과.행들.forEach(function (행) {
          const 배열 = 행을배열로(L, 행);
          const 왼 = 배열.slice(0, L.구분열).join(' | ');
          const 오 = 배열.slice(L.구분열 + 1).join(' | ');
          p('   ' + 왼 + '   ‖   ' + (행.성공 ? 오 : '*** 미매핑: ' + 행.사유));
        });
      }

      p('');
      p('   ' + 검산_설명(R.검산결과).split('\n').join('\n   '));

      if (R.경고.length) {
        p('');
        p('   경고 ' + R.경고.length + '건:');
        R.경고.forEach(function (w) { p('     ! ' + w); });
      }
    });
  });

  return 줄.join('\n');
}

/** 시트 메뉴용 래퍼 */
function 처리_테스트_메뉴() {
  const 결과 = 처리_테스트();
  const ui = SpreadsheetApp.getUi();
  ui.alert('처리 테스트 (추출→파싱→매핑→검산)', 결과.slice(0, 4000), ui.ButtonSet.OK);
}
