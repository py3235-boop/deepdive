/**
 * 80_식별.gs — 어느 고객사의 발주서인지 판별한다.
 *
 * 판별 규칙을 코드에 박지 않는다. 관리 시트 `고객사식별` 탭에서 읽는다.
 * 고객사가 늘거나 키워드를 바꿀 때 코드를 고치지 않아도 된다.
 *
 *   | 고객사   | 검사대상 | 키워드   | 가중치 |
 *   | 고객사A  | 파일명   | 고객사A  | 10     |
 *   | 고객사A  | 문서내용 | ZWCSS    | 4      |
 *
 * 매칭된 규칙의 가중치를 고객사별로 합산해 최고점을 택한다. 동점이거나 0점이면 미분류.
 *
 * ── 가중치 설계 근거 ──
 * 파일명·메일제목·메일본문은 **OCR 을 타지 않는다** (파일명은 메타데이터, 메일은 텍스트).
 * 그래서 이미지·스캔으로 들어와도 안전하다. 문서내용은 OCR 오인식 위험이 있어 낮게 둔다.
 *
 * ── 절대 쓰면 안 되는 키워드 (발주서 데이터에서 충돌 확인) ──
 *   `딥다이브`              — A·B·C 전부에 등장한다 (자사명)
 *   `AVSS 2.0SQ` `37/0.260` — A 와 C 양쪽에 등장한다
 */

/** 검사대상 이름 → 문맥에서 꺼낼 키 */
const _검사대상표 = {
  '발신자': '발신자',
  '파일명': '파일명',
  '메일제목': '메일제목',
  '제목': '메일제목',
  '메일본문': '메일본문',
  '본문': '메일본문',
  '첨부파일명': '파일명',
  '문서내용': '문서내용',
};

/** 식별 규칙을 캐시한다 (실행 단위). */
let _식별규칙캐시 = null;

/**
 * 고객사식별 탭을 읽어 규칙 목록을 만든다.
 * **키워드가 빈 행은 건너뛴다** — 안 그러면 모든 것에 매칭돼 버린다
 * (발신자 주소를 아직 모를 때 빈칸으로 두는 행이 있다).
 */
function 식별규칙_로드() {
  if (_식별규칙캐시) return _식별규칙캐시;

  const sheet = 관리시트().getSheetByName(탭.고객사식별);
  const 규칙들 = [];
  const 경고 = [];

  if (!sheet || sheet.getLastRow() < 2) {
    경고.push('고객사식별 탭에 규칙이 없습니다. 설치() 를 실행하세요');
    _식별규칙캐시 = { 규칙들: 규칙들, 경고: 경고 };
    return _식별규칙캐시;
  }

  const 격자 = sheet.getDataRange().getValues();
  const 헤더 = 격자[0].map(function (v) { return String(v || '').trim(); });
  const i고객사 = _열찾기(헤더, '고객사');
  const i대상 = _열찾기(헤더, '검사대상');
  const i키워드 = _열찾기(헤더, '키워드');
  const i가중치 = _열찾기(헤더, '가중치');

  if (i고객사 < 0 || i대상 < 0 || i키워드 < 0) {
    경고.push('고객사식별 탭 헤더가 다릅니다 (고객사/검사대상/키워드/가중치 필요)');
    _식별규칙캐시 = { 규칙들: 규칙들, 경고: 경고 };
    return _식별규칙캐시;
  }

  for (let r = 1; r < 격자.length; r++) {
    const 고객사 = String(격자[r][i고객사] || '').trim();
    const 대상원문 = String(격자[r][i대상] || '').trim();
    const 키워드 = String(격자[r][i키워드] || '').trim();
    const 가중치 = i가중치 >= 0 ? (숫자파싱(격자[r][i가중치]) || 1) : 1;

    if (!고객사) continue;
    if (!키워드) continue;                       // 빈 키워드는 무시 (전부 매칭 방지)

    const 대상 = _검사대상표[대상원문.replace(/\s+/g, '')];
    if (!대상) {
      경고.push((r + 1) + '행: 알 수 없는 검사대상 "' + 대상원문 + '" — 건너뜁니다');
      continue;
    }

    규칙들.push({
      고객사: 고객사, 대상: 대상, 키워드: 키워드, 가중치: 가중치, 행: r + 1,
    });
  }

  _식별규칙캐시 = { 규칙들: 규칙들, 경고: 경고 };
  return _식별규칙캐시;
}

/**
 * 고객사를 판별한다.
 *
 * @param {Object} 문맥
 *   - 폴더고객사 {string} 드라이브 폴더로 이미 확정된 경우. 있으면 규칙 평가를 생략한다
 *   - 발신자   {string}
 *   - 파일명   {string}
 *   - 메일제목 {string}
 *   - 메일본문 {string}
 *   - 문서내용 {string}  추출된 원문 (아직 추출 전이면 비워 둔다)
 * @return {{고객사:string|null, 점수:number, 점수표:Object, 근거:string, 확정:boolean}}
 */
function 고객사식별(문맥) {
  문맥 = 문맥 || {};

  // 드라이브 폴더 위치가 곧 답인 경우
  if (문맥.폴더고객사) {
    return {
      고객사: 문맥.폴더고객사, 점수: 999, 점수표: {},
      근거: '드라이브 폴더 위치(' + 문맥.폴더고객사 + ')로 확정', 확정: true,
    };
  }

  const 로드 = 식별규칙_로드();
  const 점수표 = {};
  const 맞은규칙 = [];

  로드.규칙들.forEach(function (규칙) {
    const 대상값 = 문맥[규칙.대상];
    if (!대상값) return;

    // 공백 제거 + 소문자로 맞춘 뒤 부분일치.
    // 파일명 표기가 `고객사B`(공백없음) / `고객사 A`(공백있음) 로 섞여 있어 필수다.
    if (키정규화(대상값).indexOf(키정규화(규칙.키워드)) < 0) return;

    점수표[규칙.고객사] = (점수표[규칙.고객사] || 0) + 규칙.가중치;
    맞은규칙.push(규칙.대상 + '="' + 규칙.키워드 + '"(+' + 규칙.가중치 + '→' + 규칙.고객사 + ')');
  });

  const 후보들 = Object.keys(점수표).sort(function (a, b) { return 점수표[b] - 점수표[a]; });

  if (!후보들.length) {
    return {
      고객사: null, 점수: 0, 점수표: 점수표,
      근거: '매칭된 키워드가 없습니다', 확정: false,
    };
  }

  const 최고 = 후보들[0];
  const 최고점 = 점수표[최고];

  if (후보들.length > 1 && 점수표[후보들[1]] === 최고점) {
    return {
      고객사: null, 점수: 최고점, 점수표: 점수표,
      근거: '동점이라 판별 불가 (' + 후보들.filter(function (c) {
        return 점수표[c] === 최고점;
      }).join(', ') + ' 각 ' + 최고점 + '점) / ' + 맞은규칙.join(', '),
      확정: false,
    };
  }

  return {
    고객사: 최고, 점수: 최고점, 점수표: 점수표,
    근거: 최고 + ' ' + 최고점 + '점 — ' + 맞은규칙.join(', '),
    확정: true,
  };
}

/** 폴더 ID 로 고객사를 되찾는다 (드라이브 폴더 경로용). 못 찾으면 null. */
function 폴더에서고객사(폴더ID) {
  const 설정 = 설정전체();
  for (let i = 0; i < 고객사목록.length; i++) {
    if (설정['폴더.' + 고객사목록[i]] === 폴더ID) return 고객사목록[i];
  }
  return null;
}

/** 고객사 이름으로 저장 폴더를 얻는다. 미분류면 미분류 폴더. */
function 고객사폴더(고객사) {
  const 키 = 고객사 ? '폴더.' + 고객사 : '폴더.미분류';
  const ID = 설정전체()[키] || 설정전체()['폴더.미분류'];
  if (!ID) throw new Error('저장 폴더를 찾을 수 없습니다: ' + 키);
  return DriveApp.getFolderById(ID);
}

// ─────────────────────────────────────────────────────────────
// 검증
// ─────────────────────────────────────────────────────────────

/**
 * Phase 5 검증용. 규칙이 제대로 로드되는지, 실제 파일명·문서내용으로 판별이 되는지 본다.
 * 특히 **키워드 충돌**을 확인한다 — 여러 고객사가 같이 매칭되면 동점으로 떨어진다.
 */
function 식별_테스트() {
  const 줄 = [];
  function p(s) { 줄.push(s); Logger.log(s); }

  _식별규칙캐시 = null;
  const 로드 = 식별규칙_로드();

  p('===== 식별 규칙 ' + 로드.규칙들.length + '개 =====');
  로드.규칙들.forEach(function (r) {
    p('   ' + r.고객사 + ' / ' + r.대상 + ' / "' + r.키워드 + '" / +' + r.가중치);
  });
  if (로드.경고.length) {
    p('   경고:');
    로드.경고.forEach(function (w) { p('     ! ' + w); });
  }

  p('');
  p('===== 판별 시험 =====');

  const 시험들 = [
    { 이름: '파일명만 (공백 없음)', 문맥: { 파일명: '고객사B 9월 발주서.png' } },
    { 이름: '파일명만 (공백 있음)', 문맥: { 파일명: '고객사 A 9월 발주서.docx' } },
    { 이름: '메일제목', 문맥: { 메일제목: '[고객사C] 9월 자재 발주 건' } },
    { 이름: '문서내용 ZWCSS', 문맥: { 문서내용: '업체코드 116308 딥다이브 ZWCSS-00030 ZWCSS-00030-P 0.3SQ' } },
    { 이름: '문서내용 동선발주', 문맥: { 문서내용: '2026년 09월 동선발주 계획 연동집합선 7/0.26 7,980' } },
    { 이름: '문서내용 EP-0101', 문맥: { 문서내용: '발 주 서 고객사 C 김 도 현 EP-0101(Rev.0)' } },
    { 이름: '단서 없음 → 미분류', 문맥: { 파일명: '9월 발주내역.pdf', 문서내용: '품명 규격 수량' } },
    { 이름: '자사명만 → 미분류여야 함', 문맥: { 문서내용: '㈜딥다이브 귀중' } },
    { 이름: '드라이브 폴더로 확정', 문맥: { 폴더고객사: '고객사B', 파일명: '아무거나.png' } },
  ];

  시험들.forEach(function (시험) {
    const r = 고객사식별(시험.문맥);
    p('');
    p('── ' + 시험.이름);
    p('   결과: ' + (r.고객사 || '미분류') + ' (' + r.점수 + '점)');
    p('   근거: ' + r.근거);
    if (Object.keys(r.점수표).length > 1) {
      p('   점수표: ' + JSON.stringify(r.점수표));
    }
  });

  p('');
  p('===== 실제 드라이브 파일로 판별 (폴더 힌트 없이) =====');
  고객사목록.forEach(function (고객사) {
    const 폴더ID = 설정전체()['폴더.' + 고객사];
    if (!폴더ID) return;
    const it = DriveApp.getFolderById(폴더ID).getFiles();
    while (it.hasNext()) {
      const f = it.next();
      const 추출결과 = 추출({ blob: f.getBlob(), 파일명: f.getName(), 원본ID: f.getId() });
      const r = 고객사식별({ 파일명: f.getName(), 문서내용: 추출결과.원문 });
      p('   ' + f.getName() + '  →  ' + (r.고객사 || '미분류') +
        ' (' + r.점수 + '점) ' + (r.고객사 === 고객사 ? 'OK' : '*** 실제는 ' + 고객사));
      p('      ' + r.근거);
    }
  });

  return 줄.join('\n');
}

/** 시트 메뉴용 래퍼 */
function 식별_테스트_메뉴() {
  const 결과 = 식별_테스트();
  const ui = SpreadsheetApp.getUi();
  ui.alert('식별 테스트', 결과.slice(0, 4000), ui.ButtonSet.OK);
}

// ─────────────────────────────────────────────────────────────
// 미분류 처리
// ─────────────────────────────────────────────────────────────

/** 미분류 폴더에 남아 있는(완료 표시 안 된) 파일 목록 */
function 미분류_목록() {
  const ID = 설정전체()['폴더.미분류'];
  if (!ID) return [];

  const 목록 = [];
  try {
    const it = DriveApp.getFolderById(ID).getFiles();
    while (it.hasNext()) {
      const f = it.next();
      if (완료표시됨(f.getName())) continue;
      목록.push({ ID: f.getId(), 이름: f.getName(), URL: f.getUrl() });
    }
  } catch (e) {
    Logger.log('미분류 폴더를 열지 못했습니다: ' + e);
  }
  return 목록;
}

/**
 * 미분류 파일에 고객사를 지정해 처리한다.
 * 자동 판별이 실패한 건을 사람이 구제하는 유일한 경로다.
 */
function 미분류_지정(파일ID, 고객사) {
  if (고객사목록.indexOf(고객사) < 0) {
    return '알 수 없는 고객사: ' + 고객사 + ' (' + 고객사목록.join(', ') + ' 중 하나)';
  }

  const 파일 = DriveApp.getFileById(파일ID);
  const 이름 = 파일.getName();

  // 고객사 폴더로 이동
  고객사폴더(고객사).addFile(파일);
  try {
    DriveApp.getFolderById(설정값('폴더.미분류')).removeFile(파일);
  } catch (e) {
    Logger.log('미분류 폴더에서 떼지 못했습니다(무시): ' + e);
  }

  const 규칙 = 변환규칙_로드();
  const 양식 = 양식_로드();
  const 추출결과 = 추출({ blob: 파일.getBlob(), 파일명: 이름, 원본ID: 파일ID });

  if (!추출결과.성공) {
    return 이름 + ' → 추출 실패: ' + (추출결과.메타.실패사유 || '?');
  }

  const R = 처리(고객사, 추출결과, 규칙, 양식);
  const 기록요약 = 기록(R, {
    채널: '수동 지정',
    원본이름: 이름,
    식별키: 파일ID,
    출처URL: 파일.getUrl(),
  });

  if (기록요약.보류) {
    return 이름 + ' → 보류: ' + 기록요약.메모.join(' / ');
  }

  완료표시(파일);
  return 이름 + ' → ' + 고객사 + ' 로 지정, 기록 ' + 기록요약.기록수 + '행' +
    (기록요약.대체수 ? ' (기존 ' + 기록요약.대체수 + '행 대체)' : '');
}

/**
 * 시트 메뉴용. 미분류 목록을 보여주고, 원하면 그 자리에서 고객사를 지정한다.
 * 입력 형식: `번호 고객사`  (예: `1 고객사B`)
 */
function 미분류_목록_메뉴() {
  const ui = SpreadsheetApp.getUi();
  const 목록 = 미분류_목록();

  if (!목록.length) {
    ui.alert('미분류', '미분류 대기 중인 파일이 없습니다.', ui.ButtonSet.OK);
    return;
  }

  const 줄 = 목록.map(function (f, i) { return (i + 1) + '. ' + f.이름; });
  const 답 = ui.prompt(
    '미분류 ' + 목록.length + '건',
    줄.join('\n') + '\n\n'
    + '지정할 항목을 "번호 고객사" 로 입력하세요 (예: 1 고객사B)\n'
    + '고객사: ' + 고객사목록.join(' / ') + '\n'
    + '취소를 누르면 목록만 확인합니다.',
    ui.ButtonSet.OK_CANCEL
  );

  if (답.getSelectedButton() !== ui.Button.OK) return;

  const 입력 = String(답.getResponseText() || '').trim();
  if (!입력) return;

  const 조각 = 입력.split(/\s+/);
  const 번호 = parseInt(조각[0], 10);
  const 고객사 = 조각.slice(1).join('');

  if (!번호 || 번호 < 1 || 번호 > 목록.length) {
    ui.alert('미분류', '번호가 1~' + 목록.length + ' 범위를 벗어났습니다: ' + 조각[0], ui.ButtonSet.OK);
    return;
  }
  if (!고객사) {
    ui.alert('미분류', '고객사를 함께 입력해주세요. 예: ' + 번호 + ' ' + 고객사목록[0], ui.ButtonSet.OK);
    return;
  }

  let 결과;
  try {
    결과 = 미분류_지정(목록[번호 - 1].ID, 고객사);
  } catch (e) {
    결과 = '실패: ' + e;
  }
  Logger.log(결과);
  ui.alert('미분류 지정 결과', 결과, ui.ButtonSet.OK);
}
